{
  "name": "@terminal-dusk/server",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase functions and SQL: the single submit write path, scheduled jobs and migrations.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --format ../../tools/eslint-formatter.mjs",
    "test": "vitest run",
    "test:migrations": "supabase db reset && vitest run src/migrations"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@terminal-dusk/content": "workspace:*",
    "@terminal-dusk/engine": "workspace:*",
    "@terminal-dusk/host": "workspace:*"
  },
  "devDependencies": {
    "supabase": "^2.120.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
