{
  // The browser tests and Playwright settings: their code runs in Node (Playwright, Vitest) and, inside page.evaluate
  // and the test pages, in the browser. A config of its own, so `src` never sees Node's globals.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["e2e", "e2e-stack", "playwright.config.ts", "playwright.stack.config.ts"]
}
