{
  "name": "@terminal-dusk/app",
  "version": "0.0.0",
  "private": true,
  "description": "React UI, transports and the Platform interface. Renders frames and sends answers; no rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --format ../../tools/eslint-formatter.mjs",
    "test": "vitest run",
    "test:stack": "node ../../tools/stack-lock.mjs vitest run src/transport/rehearsal.stack.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@terminal-dusk/ai": "workspace:*",
    "@terminal-dusk/engine": "workspace:*",
    "@terminal-dusk/host": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
