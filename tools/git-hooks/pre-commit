#!/bin/sh
# Git pre-commit hook: formats the staged files with Prettier.
# `pnpm install` turns it on (the root "prepare" script sets git's core.hooksPath to this folder).
# Locked files are never reformatted: .prettierignore lists them. docs/repo-map.md is refreshed by `pnpm repo-map`,
# not here: rewriting it in every commit made parallel pull requests conflict on it.
set -e
node node_modules/lint-staged/bin/lint-staged.js
